# ~/.gitconfig — managed by environment-setup (symlink).
# Identity (user.name / user.email) and machine-specific settings live in ~/.gitconfig.local.

[init]
	defaultBranch = main
[core]
	excludesfile = ~/.global-gitignore
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rebase]
	autoStash = true
[alias]
	st = status
	co = checkout
	br = branch
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	undo = reset --soft HEAD~1

# Must stay last so local settings win.
[include]
	path = ~/.gitconfig.local
