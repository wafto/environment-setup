#!/usr/bin/env bash
#
# Install / bootstrap this Mac. See docs/specification.md.

set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

step()    { echo ""; echo -e "${BLUE}➜${NC} $1"; }
success() { echo -e "${GREEN}✓${NC} $1"; }
warn()    { echo -e "${YELLOW}⚠${NC} $1"; }
error()   { echo -e "${RED}✗${NC} $1"; exit 1; }

[[ "$(uname -s)" == "Darwin" ]] || error "This script only supports macOS."

step "Environment setup from ${DOTFILES_DIR}"
warn "This will install/update tools on this Mac."
read -p "Continue? (y/n) " -n 1 -r
echo ""
[[ $REPLY =~ ^[Yy]$ ]] || { step "Cancelled"; exit 0; }

sudo -v

# --- Bootstrap (spec §3) ---------------------------------------------------

step "Xcode Command Line Tools"
if ! xcode-select -p &>/dev/null; then
    xcode-select --install
    error "Finish the Command Line Tools installation, then re-run this script."
fi
success "Command Line Tools present"

step "Homebrew"
if ! command -v brew &>/dev/null; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
BREW_SHELLENV='eval "$(/opt/homebrew/bin/brew shellenv)"'
touch "$HOME/.zprofile"
if ! grep -qF "$BREW_SHELLENV" "$HOME/.zprofile"; then
    echo "$BREW_SHELLENV" >> "$HOME/.zprofile"
fi
eval "$(/opt/homebrew/bin/brew shellenv)"
success "Homebrew ready"

step "Installing packages from Brewfile"
brew bundle --file="$DOTFILES_DIR/config/Brewfile" || warn "Some packages failed to install"
success "Brewfile processed"

# --- Next steps (not implemented yet) --------------------------------------
# TODO (spec §5)  PHP via brew, pecl extensions, Composer globals, fnm + Node LTS
# TODO (spec §6)  Herd migration (PATH cleanup)
# TODO (spec §10) Shell config symlinks (.zshrc, .aliases, oh-my-posh theme), ~/.hushlogin
# TODO (spec §11) Git config symlinks + local identity prompt
# TODO (spec §12) Ghostty / Zed config symlinks
# TODO (spec §13) macOS defaults and keyboard shortcuts (macos/set-defaults.sh)
# TODO (spec §14) Optional Claude Code setup

echo ""
success "Installation complete!"
