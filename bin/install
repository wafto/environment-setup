#!/usr/bin/env bash
#
# Install / bootstrap this Mac. Everything here is defined in docs/specification.md.
# Safe to re-run: every step checks its current state first.
#
# Compatible with the stock macOS bash (3.2).

set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BACKUP_DIR="$HOME/.environment-setup-backup/$(date +%Y%m%d-%H%M%S)"
BACKUP_USED=0
HERD_PRESENT=0

PHP_DEFAULT="8.5"
COMPOSER_GLOBALS=(
    laravel/installer
    laravel/pint
    laravel/valet
    laravel/envoy
    spatie/phpunit-watcher
    cpx/cpx
)

BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

step()    { echo ""; echo -e "${BLUE}➜${NC} $1"; }
success() { echo -e "${GREEN}✓${NC} $1"; }
warn()    { echo -e "${YELLOW}⚠${NC} $1"; }
error()   { echo -e "${RED}✗${NC} $1"; exit 1; }
pretty()  { local p="$1"; [[ "$p" == "$HOME"* ]] && p="~${p#"$HOME"}"; echo "$p"; }

ask() {
    local reply
    read -r -p "$1 (y/n) " -n 1 reply
    echo ""
    [[ "$reply" =~ ^[Yy]$ ]]
}

# Move an existing file/dir/symlink into this run's backup directory (spec §10).
backup_file() {
    local target="$1"
    local rel="${target#"$HOME"/}"
    mkdir -p "$BACKUP_DIR/$(dirname "$rel")"
    mv "$target" "$BACKUP_DIR/$rel"
    BACKUP_USED=1
    warn "Backed up $(pretty "$target") → $(pretty "$BACKUP_DIR/$rel")"
}

# Symlink $1 (in the repo) to $2, backing up whatever is in the way.
link_file() {
    local src="$1" dest="$2"
    [[ -e "$src" ]] || { warn "Missing $(pretty "$src"), not linking"; return 1; }
    mkdir -p "$(dirname "$dest")"

    if [[ -L "$dest" && "$(readlink "$dest")" == "$src" ]]; then
        success "$(pretty "$dest") already linked"
        return 0
    fi
    if [[ -e "$dest" || -L "$dest" ]]; then
        backup_file "$dest"
    fi
    ln -s "$src" "$dest"
    success "Linked $(pretty "$dest")"
}

# --- Preflight ---------------------------------------------------------------

preflight() {
    [[ "$(uname -s)" == "Darwin" ]] || error "This script only supports macOS."
    [[ "$(uname -m)" == "arm64" ]] || warn "Not Apple Silicon; paths assume /opt/homebrew."

    step "Environment setup from $(pretty "$DOTFILES_DIR")"
    warn "This installs/updates tools and replaces dotfiles with symlinks (originals are backed up)."
    ask "Continue?" || { step "Cancelled"; exit 0; }

    sudo -v
    # Keep sudo alive until this script exits (brew bundle and valet can take a while).
    while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &

    if [[ -d /Applications/Herd.app ]]; then
        HERD_PRESENT=1
    fi
}

# --- §3 Bootstrap ------------------------------------------------------------

install_command_line_tools() {
    step "Xcode Command Line Tools"
    if ! xcode-select -p &>/dev/null; then
        xcode-select --install || true
        error "Finish the Command Line Tools installation, then re-run this script."
    fi
    success "Command Line Tools present"
}

install_homebrew() {
    step "Homebrew"
    if [[ ! -x /opt/homebrew/bin/brew ]]; then
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    fi

    # shellcheck disable=SC2016  # written literally into ~/.zprofile
    local shellenv='eval "$(/opt/homebrew/bin/brew shellenv)"'
    touch "$HOME/.zprofile"
    if ! grep -qF "$shellenv" "$HOME/.zprofile"; then
        echo "$shellenv" >> "$HOME/.zprofile"
    fi

    eval "$(/opt/homebrew/bin/brew shellenv)"
    # Homebrew first, and nothing from Herd (it may still be on the inherited PATH).
    PATH="$(echo "$PATH" | tr ':' '\n' | grep -v '/Herd/' | paste -sd ':' -)"
    export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
    success "Homebrew ready"
}

install_brewfile() {
    step "Installing packages from Brewfile"
    brew bundle --file="$DOTFILES_DIR/config/Brewfile" || warn "Some Brewfile entries failed; re-run after fixing them"
    success "Brewfile processed"
}

# --- §10 Shell -----------------------------------------------------------------

setup_shell() {
    step "Shell configuration"
    link_file "$DOTFILES_DIR/home/.zshrc" "$HOME/.zshrc"
    touch "$HOME/.hushlogin"
    success "$(pretty "$HOME/.hushlogin") present"
}

# --- §11 Git -------------------------------------------------------------------

setup_git() {
    step "Git configuration"
    local local_config="$HOME/.gitconfig.local"

    # Read the current identity before ~/.gitconfig is replaced, to offer it as the default.
    local default_name default_email
    default_name="$(git config --global --includes --get user.name 2>/dev/null || true)"
    default_email="$(git config --global --includes --get user.email 2>/dev/null || true)"

    if ! git config --file "$local_config" --get user.name &>/dev/null; then
        local name email
        read -r -p "Git name [$default_name]: " name
        read -r -p "Git email [$default_email]: " email
        name="${name:-$default_name}"
        email="${email:-$default_email}"
        if [[ -n "$name" && -n "$email" ]]; then
            git config --file "$local_config" user.name "$name"
            git config --file "$local_config" user.email "$email"
            success "Wrote identity to $(pretty "$local_config")"
        else
            warn "No git identity given; set it later with: git config --file ~/.gitconfig.local user.name/user.email"
        fi
    else
        success "Identity already in $(pretty "$local_config")"
    fi

    link_file "$DOTFILES_DIR/home/.gitconfig" "$HOME/.gitconfig"
    link_file "$DOTFILES_DIR/home/.global-gitignore" "$HOME/.global-gitignore"
}

# --- §5 PHP ----------------------------------------------------------------------

setup_php() {
    step "PHP $PHP_DEFAULT as default"
    if ! brew list "php@$PHP_DEFAULT" &>/dev/null; then
        warn "php@$PHP_DEFAULT is not installed (Brewfile failed?), skipping PHP setup"
        return 1
    fi
    brew link --force --overwrite "php@$PHP_DEFAULT" >/dev/null
    hash -r
    success "php → $(php -r 'echo PHP_VERSION;')"

    step "Xdebug off, pcov on"
    XDEBUG_NO_RESTART=1 "$DOTFILES_DIR/bin/xdebug" off all
}

install_composer() {
    step "Composer"
    local target="/opt/homebrew/bin/composer"
    if [[ -x "$target" ]]; then
        success "Composer already installed ($(composer --version 2>/dev/null | head -n1))"
        return 0
    fi

    local tmp expected actual
    tmp="$(mktemp -d)"
    expected="$(curl -fsSL https://composer.github.io/installer.sig)"
    curl -fsSL https://getcomposer.org/installer -o "$tmp/composer-setup.php"
    actual="$(php -r "echo hash_file('sha384', '$tmp/composer-setup.php');")"
    if [[ "$expected" != "$actual" ]]; then
        rm -rf "$tmp"
        warn "Composer installer checksum mismatch, not installing"
        return 1
    fi
    php "$tmp/composer-setup.php" --quiet --install-dir=/opt/homebrew/bin --filename=composer
    rm -rf "$tmp"
    success "Composer installed ($(composer --version 2>/dev/null | head -n1))"
}

install_composer_globals() {
    step "Global Composer packages"
    composer global require --quiet "${COMPOSER_GLOBALS[@]}" || warn "Some global Composer packages failed"
    success "Global Composer packages processed"
}

install_valet() {
    step "Valet"
    if [[ "$HERD_PRESENT" == 1 ]]; then
        warn "Herd is installed; it conflicts with Valet (ports 80/443, .test DNS)."
        warn "Skipping 'valet install'. Run bin/migrate-from-herd, then re-run this script."
        return 0
    fi

    local bin_dir
    bin_dir="$(composer global config bin-dir --absolute 2>/dev/null)"
    if [[ ! -x "$bin_dir/valet" ]]; then
        warn "valet binary not found in $(pretty "$bin_dir"), skipping"
        return 1
    fi
    "$bin_dir/valet" install
    success "Valet installed"
}

# --- §5 Node -----------------------------------------------------------------------

setup_node() {
    step "Node (fnm)"
    if ! command -v fnm &>/dev/null; then
        warn "fnm is not installed (Brewfile failed?), skipping"
        return 1
    fi
    eval "$(fnm env --shell bash)"
    fnm install --lts
    fnm default lts-latest
    success "Node $(fnm exec --using=default node --version) is the default"
}

# --- §12 Editors and terminal --------------------------------------------------------

setup_editors() {
    step "Ghostty"
    link_file "$DOTFILES_DIR/config/ghostty/config" "$HOME/.config/ghostty/config"
    # Ghostty also loads this file (after the XDG one), so it would override ours.
    local ghostty_macos="$HOME/Library/Application Support/com.mitchellh.ghostty/config"
    if [[ -f "$ghostty_macos" && ! -L "$ghostty_macos" ]]; then
        backup_file "$ghostty_macos"
    fi

    step "Zed"
    link_file "$DOTFILES_DIR/config/zed/settings.json" "$HOME/.config/zed/settings.json"
    link_file "$DOTFILES_DIR/config/zed/keymap.json" "$HOME/.config/zed/keymap.json"

    step "VS Code"
    local vscode_user="$HOME/Library/Application Support/Code/User"
    link_file "$DOTFILES_DIR/config/vscode/settings.json" "$vscode_user/settings.json"
    link_file "$DOTFILES_DIR/config/vscode/keybindings.json" "$vscode_user/keybindings.json"

    if ! command -v code &>/dev/null; then
        warn "'code' CLI not found, skipping VS Code extensions"
        return 0
    fi
    local installed missing=0 ext
    installed="$(code --list-extensions 2>/dev/null | tr '[:upper:]' '[:lower:]')"
    while IFS= read -r ext || [[ -n "$ext" ]]; do
        [[ -z "$ext" || "$ext" == \#* ]] && continue
        if ! grep -qxF "$(echo "$ext" | tr '[:upper:]' '[:lower:]')" <<< "$installed"; then
            if code --install-extension "$ext" >/dev/null; then
                success "Installed $ext"
            else
                warn "Failed to install $ext"
            fi
            missing=$((missing + 1))
        fi
    done < "$DOTFILES_DIR/config/vscode/extensions.txt"
    success "VS Code extensions processed ($missing newly installed)"
}

# --- §13 macOS -------------------------------------------------------------------------

setup_macos() {
    step "Spotlight exclusions"
    "$DOTFILES_DIR/bin/exclude-from-spotlight" || warn "Spotlight exclusions had issues"

    step "macOS defaults"
    if ask "Apply macOS defaults (screenshots, trackpad)?"; then
        "$DOTFILES_DIR/macos/set-defaults.sh" || warn "Some macOS defaults failed"
    else
        warn "Skipped macOS defaults"
    fi
}

# --- Summary ---------------------------------------------------------------------------

summary() {
    echo ""
    success "Installation complete!"
    echo ""
    step "Next steps"
    echo "  • Open a new terminal (or run: exec zsh) to load the new shell config"
    if [[ "$BACKUP_USED" == 1 ]]; then
        echo "  • Replaced files were backed up to $(pretty "$BACKUP_DIR")"
    fi
    if [[ "$HERD_PRESENT" == 1 ]]; then
        echo "  • Herd is still installed: run bin/migrate-from-herd, then re-run bin/install for Valet"
    fi
    echo "  • Xdebug is off; enable it with: xdebug-on"
    echo ""
}

main() {
    preflight
    install_command_line_tools
    install_homebrew
    install_brewfile
    setup_shell
    setup_git
    if setup_php; then
        if ! { install_composer && install_composer_globals && install_valet; }; then
            warn "PHP tooling incomplete"
        fi
    fi
    setup_node || true
    setup_editors
    setup_macos
    summary
}

# Allow sourcing the helpers (e.g. for tests) without running the installer.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
